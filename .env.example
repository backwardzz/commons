# OAuth Client ID для входа через Google (тип «Web application»).
# Разрешённые источники JavaScript: http://localhost:5190 и адрес сайта, например https://backwardzz.github.io
VITE_GOOGLE_CLIENT_ID=

# Общая база Supabase. Без этих строк сайт работает как демо в браузере.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
