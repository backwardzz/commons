{
  "name": "commons",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Commons — открытая платформа совместного создания проектов",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:functions": "esbuild src/server/core.ts --bundle --format=esm --platform=neutral --target=es2022 --outfile=supabase/functions/ops/core.js --log-level=warning",
    "db:start": "supabase start -x imgproxy,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "functions:serve": "npm run build:functions && supabase functions serve ops --env-file supabase/functions/.env",
    "seed:db": "esbuild scripts/seed-db.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/seed-db.mjs --log-level=warning && node node_modules/.cache/seed-db.mjs",
    "smoke:db": "esbuild scripts/smoke-db.ts --bundle --platform=node --format=esm --packages=external --outfile=node_modules/.cache/smoke-db.mjs --log-level=warning && node node_modules/.cache/smoke-db.mjs",
    "deploy:functions": "npm run build:functions && supabase functions deploy ops --no-verify-jwt"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "supabase": "^2.119.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
